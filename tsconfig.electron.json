{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "electron/**/*.ts",
    "src/shared/types.ts",
    "src/shared/project-name.cjs",
    "electron/**/*.cjs"
  ]
}
