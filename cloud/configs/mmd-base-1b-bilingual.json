{
  "schema_version": "mct.model-config.v1",
  "model_family": "MMD-Base-1B-Bilingual",
  "stage": "base-test",
  "description": "Approximately 1.023B-parameter Persian/English decoder-only Transformer; random initialization only. Requires a compatible cloud GPU and is a test baseline, not a trained model.",
  "architecture": {
    "type": "decoder_only_transformer",
    "vocab_size": 32000,
    "max_sequence_length": 256,
    "hidden_size": 2048,
    "num_layers": 19,
    "num_attention_heads": 16,
    "feed_forward_multiplier": 4,
    "dropout": 0.1,
    "tie_word_embeddings": true
  },
  "tokenizer": {
    "type": "byte_level_bpe",
    "training_from_scratch": true,
    "target_vocab_size": 32000,
    "normalization": "unicode_nfc",
    "languages": [
      "fa",
      "en"
    ]
  },
  "initialization": {
    "weights": "random",
    "method": "architecture_defined",
    "seed": 20261108
  },
  "training": {
    "objective": "causal_language_modeling_next_token_prediction",
    "optimizer": "adamw_8bit",
    "learning_rate": 0.0001,
    "weight_decay": 0.1,
    "warmup_steps": 100,
    "max_steps": 1000,
    "micro_batch_size": 1,
    "gradient_accumulation_steps": 16,
    "gradient_clipping": 1,
    "precision": "auto",
    "checkpoint_interval_steps": 25,
    "evaluation_interval_steps": 50,
    "resume_from_checkpoint": true,
    "gradient_checkpointing": true
  },
  "data": {
    "require_license_record": true,
    "require_provenance_record": true,
    "deduplicate": true,
    "split": [
      "train",
      "validation",
      "test"
    ],
    "language_balance": "measure_before_sampling"
  },
  "resource_policy": {
    "target": "free_compliant_cloud_notebooks",
    "paid_fallback": false,
    "user_started_sessions_only": true,
    "save_checkpoint_before_runtime_limit": true,
    "require_cuda": true,
    "minimum_gpu_memory_gib": 24,
    "hardware_note": "8-bit AdamW state lower bound is about 9.53 GiB before activations and runtime overhead; gradient checkpointing reduces activation memory. 14 GiB is a minimum preflight, not a fit guarantee."
  }
}
